[{"n":"Castello di Murisengo","lat":45.08565,"lon":8.14084,"c":"Murisengo Monferrato","k":3,"wd":"Q110966256","t":"castello","w":"Castello di Murisengo","a":"Nel 1813 all'interno dell'edificio venne ospitato Silvio Pellico che durante il suo soggiorno a Murisengo compose la sua tragedia Francesca da Rimini. Dal 2005 il castello è proprietà della famiglia Collura Di Leo che patrocinò il recupero e il restauro della struttura.."},{"n":"cimitero di Murisengo","lat":45.0868,"lon":8.1425,"c":"Murisengo Monferrato","k":1,"wd":"Q92205263","t":"cimitero"},{"n":"cimitero di San Candido","lat":45.08969,"lon":8.1473,"c":"Murisengo Monferrato","k":1,"wd":"Q92205275","t":"cimitero"},{"n":"chiesa di Sant'Antonio Abate","lat":45.08512,"lon":8.14139,"c":"Murisengo Monferrato","k":2,"wd":"Q97441232","t":"chiesa"},{"n":"chiesa di San Candido","lat":45.08779,"lon":8.14877,"c":"Murisengo Monferrato","k":2,"wd":"Q120492772","t":"chiesa"}]