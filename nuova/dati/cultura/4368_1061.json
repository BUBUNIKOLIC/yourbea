[{"n":"Museo della Ceramica \"Lodovico Coccapani\"","lat":43.68447,"lon":10.61394,"c":"Calcinaia","k":1,"wd":"Q25400346","t":"museo di un ente pubblico","w":"Fornace Coccapani","d":"La fornace Coccapani di Calcinaia fu realizzata nel 1768, trasformando in officina gli edifici annessi alla torre duecentesca, già di proprietà della famiglia Coccapani. Essa era destinata alla produzione di ceramica invetriata di uso comune. Dal 12 dicembre del 2015 è adibita a museo della ceramica."},{"n":"Torre degli Upezzinghi","lat":43.68395,"lon":10.61404,"c":"Calcinaia","k":2,"wd":"Q55110091","t":"torre"},{"n":"chiesa della Compagnia di San Michele","lat":43.68372,"lon":10.61517,"c":"Calcinaia","k":2,"wd":"Q55110088","t":"chiesa"},{"n":"Monumento ai Caduti","lat":43.68299,"lon":10.6151,"c":"Calcinaia","k":2,"wd":"Q55805818","t":"monumento"},{"n":"Torre Mozza","lat":43.68431,"lon":10.61441,"c":"Calcinaia","k":2,"wd":"Q66475476","t":"torre"},{"n":"Biblioteca Pier Paolo Pasolini","lat":43.68258,"lon":10.61582,"c":"Calcinaia","k":1,"wd":"Q66475492","t":"biblioteca di un ente territoriale italiano"},{"n":"Palazzo comunale","lat":43.6828,"lon":10.61569,"c":"Calcinaia","k":1,"wd":"Q66475921","t":"palazzo comunale"},{"n":"oratorio di Santa Maria del Carmine e Sant'Antonio da Padova","lat":43.68423,"lon":10.61349,"c":"Calcinaia","k":2,"wd":"Q66709899","t":"oratorio"},{"n":"Archivio storico del Comune di Calcinaia","lat":43.68258,"lon":10.61582,"c":"Calcinaia","k":1,"wd":"Q81175768","t":"biblioteca comunale"},{"n":"Monumento al Gemellaggio","lat":43.68205,"lon":10.61637,"c":"Calcinaia","k":2,"wd":"Q98538564","t":"monumento"},{"n":"Obelisco ai caduti della Resistenza","lat":43.68334,"lon":10.61429,"c":"Calcinaia","k":1,"wd":"Q110916943","t":"obelisco"},{"n":"chiesa di Santa Maria ad Nives","lat":43.68376,"lon":10.61422,"c":"Calcinaia","k":2,"wd":"Q121096403","t":"chiesa"},{"n":"chiesa di Santa Maria delle Querce in Oltrarno","lat":43.68376,"lon":10.61422,"c":"Calcinaia","k":2,"wd":"Q12109640