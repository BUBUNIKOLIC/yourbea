[{"n":"Santa Maria Assunta","lat":45.59341,"lon":10.15398,"c":"Gussago","k":1,"wd":"Q55164637","t":"chiesa parrocchiale cattolica","w":"Chiesa di Santa Maria Assunta (Gussago)","d":"La chiesa prepositurale di Santa Maria Assunta è la parrocchiale di Gussago, in provincia e diocesi di Brescia; fa parte della zona pastorale di Gussago.","i":"La prima pietra della chiesa fu posta nel 1743; la struttura, edificata in stile neoclassico su progetto di Giorgio Massari, venne terminata nel 1760. Nel secolo successivo l'interno della chiesa fu decorato e venne decorata la facciata, disegnata da Rodolfo Vantini e Luigi Donegani.","a":"Nel 1857 fu costruita la scalinata d'accesso alla parrocchiale, mentre nel 1879 quest'ultima venne dotata dell'organo, opera della ditta Tonoli."},{"n":"Casa via Don Mingotti 5","lat":45.5942,"lon":10.15379,"c":"Gussago","k":1,"wd":"Q112137257","t":"casa"},{"n":"Palazzo via V. Veneto 6","lat":45.59244,"lon":10.1524,"c":"Gussago","k":2,"wd":"Q112137860","t":"palazzo italiano"},{"n":"Casa via Roma","lat":45.59577,"lon":10.15269,"c":"Gussago","k":1,"wd":"Q112137992","t":"casa"},{"n":"Palazzo via Roma 91","lat":45.59713,"lon":10.15252,"c":"Gussago","k":2,"wd":"Q112138130","t":"palazzo italiano"},{"n":"Villa ex Marelli","lat":45.59436,"lon":10.15373,"c":"Gussago","k":2,"wd":"Q112139769","t":"palazzo italiano"},{"n":"Casa via Forcella 4","lat":45.59793,"lon":10.15753,"c":"Gussago","k":1,"wd":"Q112139832","t":"casa"},{"n":"Casa via Chiesa 18","lat":45.59367,"lon":10.15564,"c":"Gussago","k":1,"wd":"Q112139921","t":"casa"},{"n":"Casa via Forcella 20","lat":45.59815,"lon":10.15901,"c":"Gussago","k":1,"wd":"Q112140569","t":"casa"},{"n":"Casa via Larga 6","lat":45.5925,"lon":10.15795,"c":"Gussago","k":1,"wd":"Q112141125","t":"casa"},{"n":"chiesa di Santa Maria Vecchia Pieve","lat":45.59871,"lon":10.15656,"c":"Gussago","k":2,"wd":"Q112673640","t":"chiesa"},{"n":"chiesa di San Lorenzo","lat":45.59444,"lon":10.15338,"c":"Gussago","k":2,"wd":"Q112673738","t":"c