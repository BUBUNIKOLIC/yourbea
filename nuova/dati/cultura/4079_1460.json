[{"n":"stazione di San Valentino","lat":40.7972,"lon":14.6002,"c":"San Valentino Torio","k":0,"wd":"Q3970849","t":"stazione ferroviaria","w":"Stazione di San Valentino","d":"La stazione di San Valentino è una stazione della ferrovia Circumvesuviana, sita nel comune di San Valentino Torio. Si trova sulla ferrovia Napoli-Ottaviano-Sarno.","a":"La stazione fu attivata nel 1904, all'apertura della tratta da San Giuseppe Vesuviano a Sarno, che completava la linea Napoli–Ottaviano–Sarno."},{"n":"chiesa San Giacomo Maggiore Apostolo","lat":40.79261,"lon":14.60183,"c":"San Valentino Torio","k":2,"wd":"Q106702076","t":"chiesa"},{"n":"chiesa Maria Santissima della Consolazione","lat":40.79392,"lon":14.60246,"c":"San Valentino Torio","k":2,"wd":"Q106702288","t":"chiesa"},{"n":"cimitero di San Valentino Torio","lat":40.7905,"lon":14.6062,"c":"San Valentino Torio","k":1,"wd":"Q111700301","t":"cimitero"},{"n":"Biblioteca Comunale - Città Degli Innamorati","lat":40.79167,"lon":14.60168,"c":"San Valentino Torio","k":1,"wd":"Q112844644","t":"biblioteca pubblica"},{"n":"Cappella San Severino","lat":40.79186,"lon":14.60004,"c":"San Valentino Torio","k":1,"wd":"Q118539815","t":"cappella"},{"n":"Cappella della Congrega del Monte dei Morti","lat":40.79386,"lon":14.6025,"c":"San Valentino Torio","k":1,"wd":"Q118540720","t":"cappella"},{"n":"palazzo comunale","lat":40.79215,"lon":14.60078,"c":"San Valentino Torio","k":1,"wd":"Q136186515","t":"palazzo comunale"}]