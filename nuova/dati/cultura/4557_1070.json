[{"n":"Palazzo Fregoso","lat":45.576,"lon":10.70704,"c":"Garda","k":2,"wd":"Q86671088","t":"palazzo","w":"Palazzo Fregoso (Garda)","d":"Palazzo Fregoso è un edificio del centro storico di Garda, in provincia di Verona. Edificato nel XV secolo sopra la porta settentrionale di San Giovanni, appartenne al diplomatico e generale Cesare Fregoso, esule genovese al servizio della Serenissima e figlio del doge di Genova Giano Fregoso, che qui si trasferì assieme al suo segretario Matteo Bandello nella prima metà del XVI secolo."},{"n":"chiesa di Santo Stefano","lat":45.57492,"lon":10.70829,"c":"Garda","k":2,"wd":"Q27987282","t":"chiesa"},{"n":"Palazzo Pincini Carlotti","lat":45.5752,"lon":10.70773,"c":"Garda","k":2,"wd":"Q27989490","t":"palazzo italiano"},{"n":"monumento ai Marinai","lat":45.5745,"lon":10.70704,"c":"Garda","k":2,"wd":"Q27991174","t":"monumento"},{"n":"monumento celebrativo del Corpo dei Fanti","lat":45.57286,"lon":10.70935,"c":"Garda","k":2,"wd":"Q27991175","t":"monumento"},{"n":"Museo del Lago di Garda","lat":45.57403,"lon":10.70747,"c":"Garda","k":1,"wd":"Q27992774","t":"museo etnografico"},{"n":"Torre dell'Orologio","lat":45.57598,"lon":10.70691,"c":"Garda","k":2,"wd":"Q27993914","t":"torre"},{"n":"Fontana dei Giardinetti San Carlo","lat":45.57696,"lon":10.70494,"c":"Garda","k":2,"wd":"Q27994869","t":"fontana"},{"n":"busto di Floreste Malfer","lat":45.57707,"lon":10.70473,"c":"Garda","k":1,"wd":"Q29883801","t":"monumento commemorativo"},{"n":"Vecchio municipio","lat":45.5745,"lon":10.70704,"c":"Garda","k":2,"wd":"Q56258931","t":"palazzo italiano"},{"n":"stazione di Garda","lat":45.5732,"lon":10.70884,"c":"Garda","k":0,"wd":"Q108326740","t":"stazione ferroviaria"},{"n":"Biblioteca Comunale Pino Crescini di Garda","lat":45.57539,"lon":10.70646,"c":"Garda","k":1,"wd":"Q112959921","t":"biblioteca di un ente territoriale italiano"},{"n":"Villa Becelli Albertini","lat":45.57784,"lon":10.70456,"c":"Garda","k":2,"wd":"Q115910678","t":"villa"},{"n":"chiesa di San