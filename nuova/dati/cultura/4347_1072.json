[{"n":"teatro comunale","lat":43.47413,"lon":10.7284,"c":"Lajatico","k":2,"wd":"Q3982223","t":"teatro","w":"Teatro comunale (Lajatico)"},{"n":"chiesa di San Leonardo","lat":43.47689,"lon":10.72964,"c":"Lajatico","k":2,"wd":"Q3670769","t":"chiesa","w":"Chiesa di San Leonardo (Lajatico)","i":"Dedicata al santo occitano San Leonardo di Noblac (il cui culto è praticato anche nella vicina località di Lari), le sue origini risalgono al XIII secolo, ma la chiesa fu ricostruita nel XIX secolo, quando, su progetto dell'architetto livornese Angiolo della Valle, furono apportati importanti restauri tesi ad imprimerle forme neoclassiche; i lavori furono eseguiti tra il 1853 ed il 1856."},{"n":"torre civica","lat":43.47556,"lon":10.72782,"c":"Lajatico","k":1,"wd":"Q30134634","t":"torre civica"},{"n":"Palazzo del Comune","lat":43.47505,"lon":10.72852,"c":"Lajatico","k":1,"wd":"Q30134666","t":"palazzo comunale"},{"n":"Deposito pensile Acque","lat":43.47514,"lon":10.72806,"c":"Lajatico","k":1,"wd":"Q56258409","t":"serbatoio idrico a torre"},{"n":"Biblioteca comunale di Lajatico","lat":43.47504,"lon":10.72842,"c":"Lajatico","k":1,"wd":"Q86536892","t":"biblioteca di un ente territoriale italiano"},{"n":"Palazzo pretorio","lat":43.47409,"lon":10.72833,"c":"Lajatico","k":2,"wd":"Q98673568","t":"palazzo"},{"n":"vecchie fonti","lat":43.47268,"lon":10.72644,"c":"Lajatico","k":2,"wd":"Q98684641","t":"fontana"},{"n":"Parco di Lajatico","lat":43.47491,"lon":10.72851,"c":"Lajatico","k":2,"wd":"Q98686781","t":"giardino"},{"n":"cappella dei caduti","lat":43.47631,"lon":10.72908,"c":"Lajatico","k":1,"wd":"Q98686989","t":"cappella"},{"n":"Sala polivalente San Carlo","lat":43.47588,"lon":10.72879,"c":"Lajatico","k":1,"wd":"Q98781701","t":"cappella"},{"n":"Palazzo Gotti (Lajatico)","lat":43.47559,"lon":10.72829,"c":"Lajatico","k":2,"wd":"Q98835343","t":"palazzo italiano"},{"n":"Targa ai Ruderi del Castello","lat":43.47556,"lon":10.72782,"c":"Lajatico","k":3,"wd":"Q98839766","t":"castello"},{"n":"Ca