[{"n":"chiesa di Santa Maria Assunta","lat":46.62762,"lon":10.7726,"c":"Silandro/Schlanders","k":2,"wd":"Q2082815","t":"chiesa","w":"Chiesa di Santa Maria Assunta (Silandro)","d":"La chiesa di Santa Maria Assunta (in tedesco: Pfarrkirche Mariä Himmelfahrt) a Silandro è la chiesa parrocchiale del paese. Di origine medievale, la chiesa ha un impianto gotico con rimaneggiamenti successivi in stile barocco. Il campanile alto 90,31 metri è il più alto dell'Alto Adige e dell'intera regione."},{"n":"chiesa di San Giovanni Battista","lat":46.62742,"lon":10.77472,"c":"Silandro/Schlanders","k":2,"wd":"Q107068068","t":"chiesa"},{"n":"cimitero di Silandro","lat":46.62725,"lon":10.77179,"c":"Silandro/Schlanders","k":1,"wd":"Q110005590","t":"cimitero"},{"n":"cappella di San Michele","lat":46.62773,"lon":10.77295,"c":"Silandro/Schlanders","k":1,"wd":"Q125044515","t":"cappella cimiteriale"},{"n":"chiesa di Sant'Ingenuino","lat":46.62843,"lon":10.77839,"c":"Silandro/Schlanders","k":1,"wd":"Q20089395","t":"chiesa sconsacrata"},{"n":"chiesa della Santa Trinità","lat":46.62873,"lon":10.7773,"c":"Silandro/Schlanders","k":2,"wd":"Q20821372","t":"chiesa"},{"n":"ospedale di Silandro","lat":46.62893,"lon":10.77863,"c":"Silandro/Schlanders","k":0,"wd":"Q53734597","t":"ospedale"}]