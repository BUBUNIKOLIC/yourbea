[{"n":"Castello Pallavicini Serbelloni","lat":45.22292,"lon":9.69284,"cf":"A pianta rettangolare a corte chiusa e quattro torri angolari di forma diversa (due quadrate, una circolare soprelevata in forma poligonale e una poligonale), ricorda la passata funzione difensiva; nelle forma attuali risale al 1551 e presenta elementi manieristici nella fronte di accesso con presenza di mascheroni, e nel portico colonne binate e archi a tutto sesto. Presenta fronte bugnata","k":3,"t":"castello"},{"n":"chiesa dell'Annunciata","lat":45.22071,"lon":9.69332,"c":"Castiglione d'Adda","k":2,"wd":"Q77597230","t":"chiesa"},{"n":"palazzo della Banca Popolare di Lodi","lat":45.22072,"lon":9.69258,"c":"Castiglione d'Adda","k":2,"wd":"Q77600354","t":"palazzo italiano"},{"n":"Cascina Castello","lat":45.22253,"lon":9.69134,"c":"Castiglione d'Adda","k":3,"wd":"Q77604102","t":"castello"},{"n":"ex municipio","lat":45.22083,"lon":9.69294,"c":"Castiglione d'Adda","k":1,"wd":"Q77606480","t":"ex palazzo comunale"},{"n":"palazzo Busca","lat":45.22221,"lon":9.69517,"c":"Castiglione d'Adda","k":2,"wd":"Q77606679","t":"palazzo italiano"},{"n":"ex convento delle Orsoline","lat":45.22085,"lon":9.69156,"c":"Castiglione d'Adda","k":1,"wd":"Q77607205","t":"ex edificio religioso"},{"n":"Biblioteca Comunale Agamennone Amiti","lat":45.22076,"lon":9.69291,"c":"Castiglione d'Adda","k":1,"wd":"Q112941260","t":"biblioteca di un ente territoriale italiano"},{"n":"piazza Giacomo Matteotti","lat":45.22066,"lon":9.69299,"c":"Castiglione d'Adda","k":2,"wd":"Q136801408","t":"piazza"},{"n":"Monumento ai Caduti","lat":45.22065,"lon":9.69293,"c":"Castiglione d'Adda","k":1,"wd":"Q136801491","t":"monumento commemorativo"}]