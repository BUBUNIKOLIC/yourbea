[{"n":"Cappella ai Caduti di Iseo","lat":45.65831,"lon":10.04777,"cf":"La cappella, dedicata ai caduti e ai dispersi di tutte le guerre, è situata nell'ala nord del fabbricato in cui ha sede la \"Scuola Materna Andrea Zuccoli\". La facciata della cappella, sul fronte nord dell'edificio, è inquadrata da due lesene e suddivisa orizzontalmente da una fascia marcapiano, interrotta in corrispondenza del portone e delle finestre. Ai lati del portone di ingresso, sono affisse due targhe in pietra bianca con incisa, in alto al centro, la stella d'Italia.","k":1,"t":"cappella"},{"n":"vecchia stazione di Iseo","lat":45.65725,"lon":10.0488,"c":"Iseo","k":1,"wd":"Q91331679","t":"stazione ferroviaria dismessa","w":"Stazione di Iseo (1885)","d":"La stazione di Iseo fu la stazione ferroviaria capolinea della Brescia-Iseo, posta a servizio dell'omonimo comune. Fu in funzione dal 1885 al 1907, quando fu sostituita dall'attuale."},{"n":"Casa via Duomo 34","lat":45.65987,"lon":10.04937,"c":"Iseo","k":1,"wd":"Q112139935","t":"casa"},{"n":"Casa Vicolo Zuccoli","lat":45.65905,"lon":10.04938,"c":"Iseo","k":1,"wd":"Q112140020","t":"casa"},{"n":"Ospedale Cacciamatta Iseo (ex)","lat":45.65774,"lon":10.04584,"c":"Iseo","k":2,"wd":"Q112140527","t":"palazzo italiano"},{"n":"Casa Largo Zanardelli 20","lat":45.65869,"lon":10.04816,"c":"Iseo","k":1,"wd":"Q112140560","t":"casa"},{"n":"Casa via Sombrico 9","lat":45.65943,"lon":10.04894,"c":"Iseo","k":1,"wd":"Q112140788","t":"casa"},{"n":"Casa Largo Zanardelli 1","lat":45.65947,"lon":10.04764,"c":"Iseo","k":1,"wd":"Q112140801","t":"casa"},{"n":"Casa Vicolo Chiuso 6","lat":45.65921,"lon":10.04843,"c":"Iseo","k":1,"wd":"Q112140861","t":"casa"},{"n":"Casa Largo Zanardelli 12","lat":45.65912,"lon":10.04802,"c":"Iseo","k":1,"wd":"Q112141179","t":"casa"},{"n":"Villa via XX Settembre 11-13","lat":45.65713,"lon":10.04933,"c":"Iseo","k":2,"wd":"Q112141567","t":"villa"},{"n":"Casa Largo Zanardelli 3","lat":45.65934,"lon":10.04775,"c":"Iseo","k":1,"wd":"Q112141