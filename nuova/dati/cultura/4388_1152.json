[{"n":"chiesa di Sant'Antonio Abate","lat":43.88844,"lon":11.52581,"c":"Dicomano","k":2,"wd":"Q3672629","t":"chiesa","w":"Chiesa di Sant'Antonio Abate (Dicomano)","a":"La chiesa fu eretta nei pressi dell'antico ospedale di Sant'Antonio a Onda, sorto sull'importante via di comunicazione per la Romagna come ricovero di pellegrini e viaggiatori. Fu completamente ricostruita nelle forme attuali fra il 1932 e il 1938, dopo le distruzioni del terremoto del 1919."},{"n":"Area \"Ex Macelli\"","lat":43.88945,"lon":11.52385,"c":"Dicomano","k":1,"wd":"Q66753648","t":"ex"},{"n":"Parco Albereta","lat":43.88902,"lon":11.52245,"c":"Dicomano","k":2,"wd":"Q66755578","t":"parco cittadino"},{"n":"Palazzetto dello sport","lat":43.88892,"lon":11.52019,"c":"Dicomano","k":1,"wd":"Q66818223","t":"palazzetto"},{"n":"Teatro ex macelli","lat":43.88944,"lon":11.52378,"c":"Dicomano","k":2,"wd":"Q66818361","t":"teatro"},{"n":"ponte della pista ciclo-pedonale","lat":43.88276,"lon":11.52716,"c":"Dicomano","k":2,"wd":"Q66922961","t":"ponte"},{"n":"Fontana \"La Pilla\"","lat":43.88985,"lon":11.52573,"c":"Dicomano","k":2,"wd":"Q66987763","t":"fontana"},{"n":"fonte di via Giuseppe Garibaldi","lat":43.88754,"lon":11.52565,"c":"Dicomano","k":1,"wd":"Q67013501","t":"fontanella"}]