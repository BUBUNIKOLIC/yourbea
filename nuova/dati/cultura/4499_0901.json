[{"n":"Ponte Rosso","lat":44.99018,"lon":9.01772,"c":"Voghera","k":2,"wd":"Q3908021","t":"ponte","w":"Ponte Rosso (Voghera)","d":"Il Ponte Rosso è un ponte di Voghera. Era chiamato ponte di S. Alessandria; era nell'angolo a levante della riva dello Staffora e a mezzogiorno dell'antica strada Romea. Dal popolo era chiamato \"ar pont ad preda\", nel vernacolo locale \"il ponte di pietra\". Ora questo appellativo è passato al nuovo ponte inaugurato nel 1938 un centinaio di metri più a nord. Il ponte si chiama così probabilmente per la sua colorazione rossastra, ripresa nel 2015 con la prima verniciatura di alcune sue parti."},{"n":"stazione di Voghera FVV","lat":44.9975,"lon":9.01026,"c":"Voghera","k":1,"wd":"Q19545582","t":"stazione ferroviaria dismessa","w":"Stazione di Voghera (FAA)"},{"n":"Palazzo Dattili della Torre","lat":44.99442,"lon":9.01048,"c":"Voghera","k":2,"wd":"Q112143453","t":"palazzo italiano"},{"n":"Casa via Emilia 133","lat":44.99413,"lon":9.0102,"c":"Voghera","k":1,"wd":"Q112143531","t":"casa"},{"n":"Oratorio del Crocifisso","lat":44.99368,"lon":9.01284,"c":"Voghera","k":2,"wd":"Q112172427","t":"oratorio"},{"n":"chiesa di Santa Caterina","lat":44.99481,"lon":9.01069,"c":"Voghera","k":2,"wd":"Q112322034","t":"chiesa"},{"n":"chiesa di San Sebastiano","lat":44.99422,"lon":9.01038,"c":"Voghera","k":2,"wd":"Q112811899","t":"chiesa"},{"n":"chiesa del Carmine","lat":44.99304,"lon":9.01155,"c":"Voghera","k":2,"wd":"Q112812474","t":"chiesa"},{"n":"chiesa di San Sebastiano","lat":44.99413,"lon":9.01044,"c":"Voghera","k":2,"wd":"Q112813508","t":"chiesa"},{"n":"chiesa del Carmine","lat":44.99306,"lon":9.0114,"c":"Voghera","k":2,"wd":"Q112813525","t":"chiesa"},{"n":"campanile della chiesa di San Sebastiano","lat":44.99406,"lon":9.01051,"c":"Voghera","k":1,"wd":"Q112817889","t":"torre campanaria"},{"n":"Ex Casa Parrocchiale della Chiesa di S. Sebastiano","lat":44.99419,"lon":9.0105,"c":"Voghera","k":2,"wd":"Q112817992","t":"chiesa"},{"n":"Campanile della Chiesa d