[{"n":"chiesa del Santissimo Redentore","lat":46.06225,"lon":11.23736,"c":"Pergine Valsugana","k":2,"wd":"Q55178180","t":"chiesa","w":"Chiesa del Santissimo Redentore (Pergine Valsugana)"},{"n":"stazione di Pergine","lat":46.0629,"lon":11.2322,"c":"Pergine Valsugana","k":0,"wd":"Q3970434","t":"stazione ferroviaria","w":"Stazione di Pergine","a":"Nel 1960 il fabbricato viaggiatori di Pergine fu riprodotto in scala H0 dalla ditta Rivarossi. La stazione fu completamente ricostruita all'inizio degli anni duemila e inserita in un ampio centro d'interscambio ferro-gomma. La nuova stazione venne attivata il 14 gennaio 2006."},{"n":"museo della scuola di Pergine Valsugana","lat":46.06217,"lon":11.23666,"c":"Pergine Valsugana","k":1,"wd":"Q55353345","t":"museo specializzato"},{"n":"chiesa di Santa Margherita","lat":46.06176,"lon":11.23757,"c":"Pergine Valsugana","k":1,"wd":"Q110278259","t":"chiesa sconsacrata"},{"n":"ex Macello","lat":46.06049,"lon":11.23903,"c":"Pergine Valsugana","k":1,"wd":"Q33250051","t":"biblioteca pubblica"},{"n":"ex filanda Chimelli-Gavazzi","lat":46.06171,"lon":11.23838,"c":"Pergine Valsugana","k":1,"wd":"Q33250268","t":"ex"},{"n":"monumento ai caduti","lat":46.0621,"lon":11.2376,"c":"Pergine Valsugana","k":1,"wd":"Q33250610","t":"monumento di avvertimento"},{"n":"teatro comunale","lat":46.06225,"lon":11.23928,"c":"Pergine Valsugana","k":2,"wd":"Q33250673","t":"teatro"},{"n":"fontana Saliente","lat":46.06195,"lon":11.23706,"c":"Pergine Valsugana","k":2,"wd":"Q33250724","t":"fontana"},{"n":"Biblioteca sovracomunale di Pergine Valsugana e Valle del Fersina","lat":46.06011,"lon":11.23868,"c":"Pergine Valsugana","k":1,"wd":"Q112944601","t":"biblioteca di un ente territoriale italiano"}]