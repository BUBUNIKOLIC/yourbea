[{"n":"Castello di Casiglio","lat":45.79486,"lon":9.20074,"c":"Erba","k":3,"wd":"Q111413143","t":"castello","w":"Castello di Casiglio","a":"Il castello di Casiglio è impostato su una precedente dimora, ristrutturata nel XIV secolo per volere del cardinale Beltramino Parravicini (che nacque proprio qui). Il castello conserva ancora una Trecentesca struttura con impianto a \"U\", dominata da una torre d'angolo. Dopo esser diventato proprietà dei Dal Verme (XV secolo), il castello dapprima tornò nelle mani dei Parravicini (1656), per poi passare alle famiglie Cavalleri e Longoni (XIX secolo), le quali dotarono il complesso di un rustico."},{"n":"chiesa parrocchiale di Santa Maria Assunta","lat":45.79562,"lon":9.20115,"c":"Erba","k":1,"wd":"Q55139867","t":"chiesa parrocchiale cattolica"},{"n":"Torre di Parravicino","lat":45.79798,"lon":9.20377,"c":"Erba","k":2,"wd":"Q67772643","t":"torre"},{"n":"Villa Coletti di Parravicino","lat":45.79778,"lon":9.20377,"c":"Erba","k":2,"wd":"Q112137066","t":"villa"},{"n":"Dipendenza di Villa Parravicino","lat":45.79774,"lon":9.2031,"c":"Erba","k":2,"wd":"Q112317887","t":"villa"},{"n":"Villa Gavazzi già Jacini","lat":45.79402,"lon":9.20451,"c":"Erba","k":2,"wd":"Q112318328","t":"villa"},{"n":"Villa Majnoni a Parravicino","lat":45.79504,"lon":9.20512,"c":"Erba","k":2,"wd":"Q112318435","t":"villa"},{"n":"Dipendenza di Villa Majnoni a Parravicino","lat":45.79493,"lon":9.20473,"c":"Erba","k":2,"wd":"Q112318456","t":"villa"},{"n":"Villa Verampio","lat":45.79936,"lon":9.20428,"c":"Erba","k":2,"wd":"Q112318698","t":"villa"},{"n":"Villa Gariboldi Vittadini di Parravicino","lat":45.79738,"lon":9.20459,"c":"Erba","k":2,"wd":"Q112319771","t":"villa"},{"n":"Rustici di Villa Parravicino","lat":45.79754,"lon":9.20389,"c":"Erba","k":2,"wd":"Q112319799","t":"villa"},{"n":"Villa Parravicino Sossnovsky","lat":45.79745,"lon":9.20353,"c":"Erba","k":2,"wd":"Q112319835","t":"villa"},{"n":"Villa Lado","lat":45.79825,"lon":9.20395,"c":"Erba","k":2,"wd":"Q11231