[{"n":"Chiesa dei Santissima Martiri Cosma e Damiano","lat":40.99372,"lon":17.21836,"cf":"facciata semplice, arricchita da un portico sorretto da due colonne, sormontate da un alto timpano triangolare di gusto tardo-neoclassico; altare barocco in marmi policromi, ai lati presenta i bassorilievi figurati di San Bernardo e San Benedetto; due cappelle laterali, già dedicate a San Vito e all'Immacolata Concezione","k":2,"t":"chiesa"},{"n":"Chiesa del Purgatoio","lat":40.99585,"lon":17.21868,"cf":"truttura cupolata impostata su quattro archi a tutto sesto determinati dalle coperture a botte delle cappelle laterali e delle zona presbiteriale","k":2,"t":"chiesa"},{"n":"stazione di Polignano a Mare","lat":40.991,"lon":17.2188,"c":"Polignano a Mare","k":0,"wd":"Q3970518","t":"stazione ferroviaria","w":"Stazione di Polignano a Mare","d":"La stazione di Polignano a Mare è una stazione ferroviaria ubicata sulla linea Adriatica, tratto di linea Bari-Lecce a servizio dell'omonimo comune. La circolazione dei treni è esercita con DCO con sede nel Posto Centrale SCC di Bari Lam. ta.Il distanziamento dei treni è con BCA banalizzato; la velocità max è di 150 km/h."},{"n":"Palazzo Miani","lat":40.99569,"lon":17.21899,"c":"Polignano a Mare","k":2,"wd":"Q113551086","t":"palazzo italiano"},{"n":"Cinta muraria","lat":40.99623,"lon":17.21831,"c":"Polignano a Mare","k":1,"wd":"Q113551118","t":"mura cittadine"},{"n":"chiesa della Natività","lat":40.99531,"lon":17.2195,"c":"Polignano a Mare","k":2,"wd":"Q121214631","t":"chiesa"},{"n":"chiesa dei Santi Martiri Cosimo e Damiano","lat":40.99369,"lon":17.21805,"c":"Polignano a Mare","k":2,"wd":"Q121214628","t":"chiesa"},{"n":"chiesa del Purgatorio","lat":40.99588,"lon":17.21859,"c":"Polignano a Mare","k":2,"wd":"Q121214629","t":"chiesa"},{"n":"chiesa Santo Stefano","lat":40.99708,"lon":17.21903,"c":"Polignano a Mare","k":2,"wd":"Q121214635","t":"chiesa"},{"n":"chiesa matrice di Santa Maria Assunta","lat":40.99623,"lon":17.21938,"c":"Polignano a Ma