[{"n":"Museo civico di Palazzo Cento","lat":43.26689,"lon":13.34855,"c":"Pollenza","k":1,"wd":"Q54854914","t":"museo di un ente pubblico","w":"Museo civico di palazzo Cento","d":"Il Museo civico di Palazzo Cento è un museo di Pollenza che conserva il patrimonio storico-artistico della cittadina marchigiana.","i":"La sede del museo è a Palazzo Cento, un antico palazzo nobiliare del XVI secolo, il cui aspetto attuale è dovuto ai restauri sei-settecenteschi. Le opere pittoriche rinascimentali e di età moderna della collezione provengono dalle chiese del territorio."},{"n":"Teatro Giuseppe Verdi (Pollenza)","lat":43.26808,"lon":13.34792,"c":"Pollenza","k":2,"wd":"Q63523647","t":"teatro","w":"Teatro Giuseppe Verdi (Pollenza)"},{"n":"chiesa di San Giuseppe","lat":43.26638,"lon":13.34877,"c":"Pollenza","k":2,"wd":"Q26258381","t":"chiesa"},{"n":"chiesa di San Biagio","lat":43.26915,"lon":13.34658,"c":"Pollenza","k":2,"wd":"Q28229327","t":"chiesa"},{"n":"Museo della tessitura","lat":43.26705,"lon":13.34868,"c":"Pollenza","k":1,"wd":"Q54855200","t":"museo etnografico"},{"n":"palazzo Cento","lat":43.26689,"lon":13.34857,"c":"Pollenza","k":2,"wd":"Q54870320","t":"palazzo"},{"n":"chiesa dei Santi Francesco e Antonio","lat":43.26843,"lon":13.34748,"c":"Pollenza","k":2,"wd":"Q55181053","t":"chiesa"},{"n":"Biblioteca comunale di Pollenza","lat":43.26677,"lon":13.34864,"c":"Pollenza","k":1,"wd":"Q81172106","t":"biblioteca di un ente territoriale italiano"},{"n":"Biblioteca della Corporazione del Melograno-Pro Loco","lat":43.26724,"lon":13.34891,"c":"Pollenza","k":1,"wd":"Q111968388","t":"biblioteca specializzata"},{"n":"Biblioteca Istituto Comprensivo \"Vincenzo Monti\"","lat":43.26653,"lon":13.34605,"c":"Pollenza","k":1,"wd":"Q112036353","t":"biblioteca scolastica"},{"n":"santuario Immacolata","lat":43.26759,"lon":13.34794,"c":"Pollenza","k":2,"wd":"Q121792270","t":"chiesa"}]